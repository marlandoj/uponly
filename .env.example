# Supabase (public — safe in the browser; RLS + explicit grants protect data)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only — never prefix with NEXT_PUBLIC_
SUPABASE_SERVICE_ROLE_KEY=
OPENAI_API_KEY=
# Optional; vision model for the progress check (default gpt-4.1-mini)
OPENAI_VISION_MODEL=
BASE_SEPOLIA_APP_SIGNER=
BASE_SEPOLIA_RPC_URL=
